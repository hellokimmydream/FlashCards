<!DOCTYPE html>

<html lang="fr">

  <head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>@!section('title')FlashCards@endsection</title>

    <style>

      body { font-family: Arial, sans-serif; margin: 0; padding: 0; }

      header { padding: 12px 16px; border-bottom: 1px solid #ddd; display:flex; gap:12px; align-items:center; }

      header a { text-decoration:none; color:#111; font-weight:bold; }

      main { padding: 16px; max-width: 900px; margin: 0 auto; }

      .flash { padding: 10px 12px; border: 1px solid; margin: 12px 0; }

      .success { border-color: #1b8a3a; color: #1b8a3a; }

      .error { border-color: #b00020; color: #b00020; }

      .card { border:1px solid #333; padding:12px; margin:10px 0; }

      .btn { padding:8px 12px; border:1px solid #333; background:#fff; cursor:pointer; }

      .btn-danger { border-color:#b00020; color:#b00020; }

      input, textarea { width: 100%; padding: 10px; border: 1px solid #333; }

      label { display:block; margin-top:10px; }

      .row { margin-top: 10px; }

      .actions { display:flex; gap:10px; margin-top: 14px; }

      a.link { color:#0b57d0; }

    </style>

  </head>



  <body>

    <header>

      <a href="/decks">FlashCards</a>

      <a class="link" href="/decks">Mes decks</a>

      <a class="link" href="/decks/create">Nouveau deck</a>

    </header>



    <main>

      @if(flashMessages.has('success'))

        <div class="flash success">{{ flashMessages.get('success') }}</div>

      @endif



      @if(flashMessages.has('error'))

        <div class="flash error">{{ flashMessages.get('error') }}</div>

      @endif



      @!section('content')@endsection

    </main>

  </body>

