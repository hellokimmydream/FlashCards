{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": ".adonis-build",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "#controllers/*": ["app/Controllers/Http/*"]
    }
  },
  "include": ["start/**/*", "app/**/*"]
}
