@component('components/layout', { title: title })
    <h3>
        Mes decks
    </h3>

    <p>
        <a href="/decks/create">Créer un deck</a>
    </p>

    @if(decks.length === 0)

        <p>
            Aucun deck
        </p>

        <ul>

            @each(deck in decks)

                <li style="margin-bottom:10px;">

                    <strong>{{ deck.title }}</strong>

                    @if(deck.description)

                        <div>
                            {{ deck.description }}
                        </div>

                        <div style="display:flex; gap:8px; margin-top:6px;">

                            <a href="/decks/{{ deck.id }}/edit">Modifier</a>

                            <a href="/decks/{{ deck.id }}/learn">Commencer à réviser</a>

                            <form action="/decks/{{ deck.id }}/delete" method="POST" style="display:inline;">
                                <button type="submit">Supprimer</button>

                            </form>
                        </div>
                    @end
                </li>
            @end
        </ul>
    @end
    
@endcomponent
